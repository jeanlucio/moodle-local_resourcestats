{{!
    @template local_resourcestats/course_insights

    Engagement highlights panel for the course statistics page.
    Displays rules-based alerts: unviewed activities, low engagement,
    and students with zero accesses across all activities.

    Context variables required for this template:
    * hasalerts - Boolean: true when at least one alert exists.
    * alerts    - Array of alert objects:
                  * type         - Bootstrap alert type: "danger" or "warning".
                  * icon         - Font Awesome icon class.
                  * message      - Count-based intro text (never contains activity names).
                  * hasitems     - Boolean: true when this alert lists activities as pills.
                  * visibleitems - Array of {name, detailurl, suffix}, shown immediately.
                  * hiddenitems  - Array of {name, detailurl, suffix}, collapsed behind a
                                   native <details> disclosure.
                  * hashidden    - Boolean: true when hiddenitems is non-empty.
                  * morelabel    - Label for the disclosure's <summary> (e.g. "Show 19 more
                                   activities"), already pluralised.

    Example context (json):
    {
        "hasalerts": true,
        "alerts": [
            {
                "type": "danger",
                "icon": "fa-eye-slash",
                "message": "2 activities not yet viewed by any student:",
                "hasitems": true,
                "visibleitems": [
                    {"name": "Bonus reading", "detailurl": "/local/resourcestats/view_stats.php?id=6", "suffix": ""},
                    {"name": "Week 4 quiz", "detailurl": "/local/resourcestats/view_stats.php?id=9", "suffix": ""}
                ],
                "hiddenitems": [],
                "hashidden": false,
                "morelabel": ""
            },
            {
                "type": "warning",
                "icon": "fa-exclamation-triangle",
                "message": "1 activity with engagement below 20%:",
                "hasitems": true,
                "visibleitems": [
                    {"name": "Week 3 - Slides", "detailurl": "/local/resourcestats/view_stats.php?id=5", "suffix": "(12%)"}
                ],
                "hiddenitems": [],
                "hashidden": false,
                "morelabel": ""
            }
        ]
    }
}}
<div class="local_resourcestats-insights mb-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark d-flex align-items-center">
            <i class="fa fa-lightbulb-o me-2 text-white" aria-hidden="true"></i>
            <h4 class="card-title h5 mb-0 text-white">{{#str}} insights, local_resourcestats {{/str}}</h4>
        </div>
        <div class="card-body">
            {{#hasalerts}}
            <ul class="list-unstyled mb-0">
                {{#alerts}}
                <li class="mb-3">
                    <div class="d-flex align-items-start">
                        <i class="fa {{icon}} me-2 mt-1 text-{{type}}" aria-hidden="true"></i>
                        <span>{{message}}</span>
                    </div>
                    {{#hasitems}}
                    <div class="local_resourcestats-tags mt-2 ms-4 d-flex flex-wrap align-items-center">
                        {{#visibleitems}}
                        <a href="{{detailurl}}" class="badge rounded-pill local-resourcestats-insight-pill">
                            {{name}}{{#suffix}} {{suffix}}{{/suffix}}
                        </a>
                        {{/visibleitems}}
                        {{#hashidden}}
                        <details class="local-resourcestats-more-details">
                            <summary class="badge rounded-pill local-resourcestats-insight-pill local-resourcestats-more-summary">
                                {{morelabel}}
                            </summary>
                            <div class="d-flex flex-wrap align-items-center mt-2">
                                {{#hiddenitems}}
                                <a href="{{detailurl}}" class="badge rounded-pill local-resourcestats-insight-pill">
                                    {{name}}{{#suffix}} {{suffix}}{{/suffix}}
                                </a>
                                {{/hiddenitems}}
                            </div>
                        </details>
                        {{/hashidden}}
                    </div>
                    {{/hasitems}}
                </li>
                {{/alerts}}
            </ul>
            {{/hasalerts}}
            {{^hasalerts}}
            <p class="mb-0 text-success">
                <i class="fa fa-check-circle me-1" aria-hidden="true"></i>
                {{#str}} insight_no_alerts, local_resourcestats {{/str}}
            </p>
            {{/hasalerts}}
        </div>
    </div>
</div>
