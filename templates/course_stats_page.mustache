{{!
    @template local_resourcestats/course_stats_page

    Course-level statistics overview: one row per activity with engagement summary.
    Activities with zero unique views are highlighted. Column headers are sort links.
    Export buttons generate a consolidated file with one row per (activity, student).

    Context variables required for this template:
    * coursename     - The course full name.
    * activities     - Array of activity rows (current page): cmid, activityname, modtype,
                       totalviews, uniqueviews, engagementpct, lastviewtime,
                       detailurl, unviewed.
    * hasactivities  - Boolean: true when at least one trackable activity exists.
    * totalstudents  - Number of enrolled students.
    * exporturlcsv   - URL for consolidated CSV download.
    * exporturlexcel - URL for consolidated Excel download.
    * prefsurl       - URL for the display preferences page.
    * headers        - Object with keys activityname, modtype, totalviews, uniqueviews,
                       engagementpct, lastviewtime; each has url, label, icon_class.
    * paginationhtml - Rendered HTML for Moodle paging bar (empty when not needed).

    Example context (json):
    {
        "coursename": "Introduction to Programming",
        "hasactivities": true,
        "totalstudents": 30,
        "exporturlcsv": "/local/resourcestats/export.php?courseid=2&format=csv",
        "exporturlexcel": "/local/resourcestats/export.php?courseid=2&format=excel",
        "prefsurl": "/local/resourcestats/preferences.php?returnurl=%2Flocal%2Fresourcestats%2Fcourse_stats.php%3Fcourseid%3D2",
        "paginationhtml": "",
        "headers": {
            "activityname":  {"url": "#", "label": "Activity",         "icon_class": "fa-sort text-muted"},
            "modtype":       {"url": "#", "label": "Type",             "icon_class": "fa-sort text-muted"},
            "totalviews":    {"url": "#", "label": "Accesses",         "icon_class": "fa-sort text-muted"},
            "uniqueviews":   {"url": "#", "label": "Unique students",  "icon_class": "fa-sort text-muted"},
            "engagementpct": {"url": "#", "label": "Engagement",       "icon_class": "fa-sort text-muted"},
            "lastviewtime":  {"url": "#", "label": "Last access",      "icon_class": "fa-sort text-muted"}
        },
        "activities": [
            {
                "cmid": 5,
                "activityname": "Week 1 - Slides",
                "modtype": "resource",
                "totalviews": 45,
                "uniqueviews": 28,
                "engagementpct": 93,
                "lastviewtime": "5 June 2026, 10:00 AM",
                "detailurl": "/local/resourcestats/view_stats.php?id=5",
                "unviewed": false
            },
            {
                "cmid": 6,
                "activityname": "Bonus reading",
                "modtype": "resource",
                "totalviews": 0,
                "uniqueviews": 0,
                "engagementpct": 0,
                "lastviewtime": "",
                "detailurl": "/local/resourcestats/view_stats.php?id=6",
                "unviewed": true
            }
        ]
    }
}}
<div class="local_resourcestats-course-page mt-4">
    {{> local_resourcestats/course_insights }}
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary d-flex align-items-center">
            <i class="fa fa-bar-chart me-2 text-white" aria-hidden="true"></i>
            <h3 class="card-title h5 mb-0 text-white">
                {{#str}} course_statistics, local_resourcestats {{/str}} — {{coursename}}
            </h3>
            <div class="ms-auto d-flex">
                <a href="{{prefsurl}}" class="btn btn-sm btn-outline-light shadow-sm me-2"
                   title="{{#str}} configure_display, local_resourcestats {{/str}}">
                    <i class="fa fa-sliders" aria-hidden="true"></i>
                    <span class="d-none d-md-inline ms-1">{{#str}} configure_display, local_resourcestats {{/str}}</span>
                </a>
                <a href="{{exporturlcsv}}" class="btn btn-sm btn-outline-light shadow-sm me-2"
                   title="{{#str}} export_csv, local_resourcestats {{/str}}">
                    <i class="fa fa-download" aria-hidden="true"></i>
                    <span class="d-none d-md-inline ms-1">{{#str}} export_csv, local_resourcestats {{/str}}</span>
                </a>
                <a href="{{exporturlexcel}}" class="btn btn-sm btn-outline-light shadow-sm"
                   title="{{#str}} export_excel, local_resourcestats {{/str}}">
                    <i class="fa fa-file-excel-o" aria-hidden="true"></i>
                    <span class="d-none d-md-inline ms-1">{{#str}} export_excel, local_resourcestats {{/str}}</span>
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            {{#hasactivities}}
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">
                                <a href="{{headers.activityname.url}}" class="text-dark text-decoration-none fw-bold d-flex align-items-center">
                                    {{headers.activityname.label}} <i class="fa {{headers.activityname.icon_class}} ms-1" aria-hidden="true"></i>
                                </a>
                            </th>
                            <th scope="col">
                                <a href="{{headers.modtype.url}}" class="text-dark text-decoration-none fw-bold d-flex align-items-center">
                                    {{headers.modtype.label}} <i class="fa {{headers.modtype.icon_class}} ms-1" aria-hidden="true"></i>
                                </a>
                            </th>
                            <th scope="col" class="text-center">
                                <a href="{{headers.totalviews.url}}" class="text-dark text-decoration-none fw-bold d-flex align-items-center justify-content-center">
                                    {{headers.totalviews.label}} <i class="fa {{headers.totalviews.icon_class}} ms-1" aria-hidden="true"></i>
                                </a>
                            </th>
                            <th scope="col" class="text-center">
                                <a href="{{headers.uniqueviews.url}}" class="text-dark text-decoration-none fw-bold d-flex align-items-center justify-content-center">
                                    {{headers.uniqueviews.label}} <i class="fa {{headers.uniqueviews.icon_class}} ms-1" aria-hidden="true"></i>
                                </a>
                            </th>
                            <th scope="col" class="text-center">
                                <a href="{{headers.engagementpct.url}}" class="text-dark text-decoration-none fw-bold d-flex align-items-center justify-content-center">
                                    {{headers.engagementpct.label}} <i class="fa {{headers.engagementpct.icon_class}} ms-1" aria-hidden="true"></i>
                                </a>
                            </th>
                            <th scope="col">
                                <a href="{{headers.lastviewtime.url}}" class="text-dark text-decoration-none fw-bold d-flex align-items-center">
                                    {{headers.lastviewtime.label}} <i class="fa {{headers.lastviewtime.icon_class}} ms-1" aria-hidden="true"></i>
                                </a>
                            </th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#activities}}
                        <tr{{#unviewed}} class="table-warning"{{/unviewed}}>
                            <td>{{activityname}}</td>
                            <td>{{modtype}}</td>
                            <td class="text-center">{{totalviews}}</td>
                            <td class="text-center">{{uniqueviews}}</td>
                            <td class="text-center">{{engagementpct}}%</td>
                            <td>
                                {{#lastviewtime}}{{lastviewtime}}{{/lastviewtime}}
                                {{^lastviewtime}}&mdash;{{/lastviewtime}}
                            </td>
                            <td>
                                <a href="{{detailurl}}" class="btn btn-sm btn-outline-secondary"
                                   title="{{#str}} view_details, local_resourcestats {{/str}}"
                                   aria-label="{{#str}} view_details, local_resourcestats {{/str}} {{activityname}}">
                                    <i class="fa fa-search" aria-hidden="true"></i>
                                </a>
                            </td>
                        </tr>
                        {{/activities}}
                    </tbody>
                </table>
            </div>
            {{/hasactivities}}
            {{^hasactivities}}
            <p class="text-muted fst-italic p-4 mb-0">{{#str}} noactivities, local_resourcestats {{/str}}</p>
            {{/hasactivities}}
        </div>
        {{#hasactivities}}
        <div class="card-footer">
            {{{paginationhtml}}}
            <p class="text-muted small mb-0">
                {{#str}} total_enrolled_students, local_resourcestats, {{totalstudents}} {{/str}}
            </p>
        </div>
        {{/hasactivities}}
    </div>
</div>
