{{!
    @template local_resourcestats/preferences

    Form for choosing which statistics badges to display on the course page.

    Context variables required for this template:
    * show_total    - Boolean: total-accesses checkbox is checked.
    * show_unique   - Boolean: unique-students checkbox is checked.
    * show_lastuser - Boolean: last-user checkbox is checked.
    * actionurl     - Form POST action URL.
    * returnurl     - URL to cancel back to.
    * sesskey       - Moodle session key for POST security.

    Example context (json):
    {
        "show_total":    true,
        "show_unique":   true,
        "show_lastuser": false,
        "actionurl":     "/local/resourcestats/preferences.php",
        "returnurl":     "/course/view.php?id=2",
        "sesskey":       "abc123"
    }
}}
<div class="local_resourcestats-preferences row justify-content-center mt-4">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark d-flex align-items-center">
                <i class="fa fa-cog me-2 text-white" aria-hidden="true"></i>
                <h2 class="h5 mb-0 text-white">{{#str}} preferences_title, local_resourcestats {{/str}}</h2>
            </div>
            <div class="card-body">
                <p class="text-muted mb-4">{{#str}} preferences_desc, local_resourcestats {{/str}}</p>
                <form method="post" action="{{actionurl}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="returnurl" value="{{returnurl}}">
                    <fieldset class="border-0 p-0 m-0">
                        <legend class="local-resourcestats-hidden">{{#str}} preferences_title, local_resourcestats {{/str}}</legend>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" name="show_total"
                                   id="local_resourcestats_show_total" value="1"
                                   {{#show_total}}checked{{/show_total}}>
                            <label class="form-check-label" for="local_resourcestats_show_total">
                                {{#str}} badge_totalviews, local_resourcestats {{/str}}
                            </label>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" name="show_unique"
                                   id="local_resourcestats_show_unique" value="1"
                                   {{#show_unique}}checked{{/show_unique}}>
                            <label class="form-check-label" for="local_resourcestats_show_unique">
                                {{#str}} badge_uniqueviews, local_resourcestats {{/str}}
                            </label>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" name="show_lastuser"
                                   id="local_resourcestats_show_lastuser" value="1"
                                   {{#show_lastuser}}checked{{/show_lastuser}}>
                            <label class="form-check-label" for="local_resourcestats_show_lastuser">
                                {{#str}} badge_lastuser, local_resourcestats {{/str}}
                            </label>
                        </div>
                    </fieldset>
                    <div class="d-flex mt-4">
                        <button type="submit" class="btn btn-primary me-2">
                            {{#str}} savechanges, core {{/str}}
                        </button>
                        <a href="{{returnurl}}" class="btn btn-secondary">
                            {{#str}} cancel, core {{/str}}
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
